# Developer-only material: the regression harness that checks this refactor
# (and the Python port) still reproduces the original solver, plus the
# reference matrices it compares against. Not part of SALT.
validation/
_ref/

# Solver output: waveform plots and <case>_results.txt, regenerated by
# run_SALT.
results/

# Archived copies of the pre-refactor sources and the migration scripts
_provenance/

# Case-preparation material. Only the finished cases in data/ are shipped;
# _tools/ holds what derived them (buildDataFile.m, build_salt_workbooks.py)
# and 2kbus_SALT_superseded.xlsx, the earlier 2000-bus workbook that sized
# each inverter on its own bus rather than on the 200 MVA / 16.5 kV base the
# timing driver uses. case2kbus_SALT.xlsx replaces it.
_tools/

# Diagnostic output kept only while a discrepancy is being chased down.
# Safe to delete.
_scratch/

# LaTeX build products
docs/*.aux
docs/*.log
docs/*.out
docs/*.toc
docs/*.synctex.gz

# MATLAB
*.asv
*.m~
*.mat
!data/*.mat          # network case files may be distributed as .mat
slprj/
codegen/
